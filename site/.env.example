# Every environment variable the site reads. Copy to .env.local and fill in; set the same names on
# the Vercel project. site/app/site-contract.test.ts fails if the site reads one that is missing
# here, because an undocumented variable is one nobody knows to provision — which is how the free
# scan shipped to production with its Resend credentials unset (#721/#1308).
#
# Free-scan intake (app/api/scan).

# Resend — create a FULL-ACCESS key at https://resend.com/api-keys
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxx

# Where new free-scan requests are emailed (your inbox).
SCAN_NOTIFY_TO=you@example.com

# Verified sender. Leave unset to use Resend's sandbox "Harvey <onboarding@resend.dev>",
# which ONLY delivers to your Resend account email — fine for the operator notification,
# but requester confirmations won't arrive until you verify harvey-qa.com in Resend and
# set this to e.g. "Harvey <scan@harvey-qa.com>".
# RESEND_FROM=Harvey <scan@harvey-qa.com>

# Search-console ownership tokens, rendered into <meta> by app/layout.tsx. Optional — both are
# unset on the Vercel project today, so neither verification tag ships. Google Search Console /
# Bing Webmaster Tools issue the values.
# NEXT_PUBLIC_GOOGLE_SITE_VERIFICATION=
# NEXT_PUBLIC_BING_SITE_VERIFICATION=
