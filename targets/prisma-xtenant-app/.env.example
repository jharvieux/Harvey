# Placeholder config for the live stand-up (#1163). Harvey forces DATABASE_URL at its own Postgres
# container and forces NEXTAUTH_SECRET to the value it mints sessions with — these are non-secret
# example placeholders so `next build` has non-empty required vars.
DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:5432/postgres
NEXTAUTH_SECRET=harvey-xtenant-fixture-dev-secret
NEXTAUTH_URL=http://127.0.0.1:3000
