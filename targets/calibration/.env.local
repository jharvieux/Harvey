# Committed .env.local for the calibration corpus. Every value here is FAKE (valid-shape,
# never a live secret) and this app is never deployed. See GROUND-TRUTH.md §"Corpus".

# N-ANON-KEY (NEGATIVE — must NOT be flagged): the Supabase anon/publishable key is public
# by design; it ships in browser code and only grants what RLS allows. Its JWT "role" claim
# decodes to "anon". A secret scanner that flags this is the single most credibility-fatal FP.
NEXT_PUBLIC_SUPABASE_URL=https://calibrationref01.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJpc3MiOiJzdXBhYmFzZSIsInJlZiI6ImNhbGlicmF0aW9ucmVmMDEiLCJyb2xlIjoiYW5vbiIsImlhdCI6MTcwMDAwMDAwMCwiZXhwIjoyMDAwMDAwMDAwfQ.Xq3fFaKk9c2Zp7wV0nRtY8sLbUmEdHjGqAoIcPwZ1kY

# P-NEXTPUBLIC-SECRET (POSITIVE — must be caught): a genuine secret mis-prefixed NEXT_PUBLIC_,
# so it is inlined into the client bundle. Caught by the NAME-based gitleaks rule
# (supabase-next-public-secret-leak: NEXT_PUBLIC_*SECRET*=value); the value is a defanged fake
# (a real provider-shaped key here trips GitHub push protection — not the point of this fixture).
NEXT_PUBLIC_STRIPE_SECRET_KEY=FAKEcalibration_stripe_secret_not_a_real_key_a9xZ3mNpQrStUvWx

# P-DB-URL-PASSWORD (POSITIVE — must be caught): a Postgres connection string with an inline
# password committed to source. Value is FAKE. Caught by the custom gitleaks
# harvey-db-uri-credentials rule (URI with credentials) → high (a committed DB credential).
DATABASE_URL=postgres://appuser:S3cr3tP4ssZ9Qm2vXc@db.calibrationref01.supabase.co:5432/postgres

# N-STRIPE-PK-PUBLISHABLE (NEGATIVE — must NOT be flagged): the Stripe publishable key is public
# by design (ships in browser code), like the Supabase anon key. gitleaks allowlist (pk_(test|
# live)_ regexTarget=line) suppresses every rule on the line.
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_live_51Qm2vXcW8rNpKdLhGfYsAe4Uo1Bx6Vt0Zi7Ny5Mw3Qr8Kp2Ld6Hj

# N-STRIPE-TEST-KEY (NEGATIVE — must NOT be flagged in the free count): a Stripe TEST-mode secret
# key. It is test-mode (no production risk); gitleaks stripe-access-token still pattern-matches it,
# so it lands at review only (triaged out of the count), never high.
STRIPE_TEST_SECRET_KEY=sk_test_51Qm2vXcW8rNpKdLhGfYsAe4Uo1Bx6Vt0Zi7Ny5Mw3Qr8Kp2Ld6Hj
