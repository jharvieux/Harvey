# Placeholders only — the live stand-up (mapAppSupabaseEnv) overwrites these with the disposable
# local stack's real creds at boot. Nothing here is a secret.
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key-here
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here

# The negative-control seams' shared secret. The vulnerable seams read no secret (that is the bug);
# the webhook + internal-route controls verify against this. Static placeholder so the probe's
# forged-signature requests fail verification and those controls stay not-vulnerable. (The service-JWT
# control verifies an RS256 signature against a public key embedded in its route — no env secret.)
WEBHOOK_SIGNING_SECRET=vuln-seam-app-webhook-secret
