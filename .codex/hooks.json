{
  "description": "Protect Harvey's checked-in durable decision history.",
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "^apply_patch$",
        "hooks": [
          {
            "type": "command",
            "command": "repo_root=\"$(git rev-parse --show-toplevel)\" && HARVEY_REPO_ROOT=\"$repo_root\" node \"$repo_root/tools/memory-apply-patch-guard.mjs\"",
            "timeout": 5,
            "statusMessage": "Protecting durable memory history"
          }
        ]
      }
    ]
  }
}
